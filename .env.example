# Copy to .env and fill in. Never commit .env.

# FalkorDB: local Docker defaults; for FalkorDB Cloud set host/port/username/password and SSL as shown in the Cloud console.
TRIVENI_FALKORDB_HOST=localhost
TRIVENI_FALKORDB_PORT=6379
TRIVENI_FALKORDB_USERNAME=
TRIVENI_FALKORDB_PASSWORD=
TRIVENI_FALKORDB_SSL=false

# Tenant used when a request does not name one. Graph name = tenant_<name>.
TRIVENI_DEFAULT_TENANT=acme

# Agent (used from the agent-loop step onward)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Replay recorded tool results instead of calling the model (demo safety net)
DEMO_REPLAY=0
