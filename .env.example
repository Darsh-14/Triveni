# Copy to .env and fill in. Never commit .env.

# FalkorDB: local Docker defaults; for FalkorDB Cloud set host/port/username/password and SSL as shown in the Cloud console.
TRIVENI_FALKORDB_HOST=localhost
TRIVENI_FALKORDB_PORT=6379
TRIVENI_FALKORDB_USERNAME=
TRIVENI_FALKORDB_PASSWORD=
TRIVENI_FALKORDB_SSL=false

# Tenant used when a request does not name one. Graph name = tenant_<name>.
TRIVENI_DEFAULT_TENANT=acme

# Models (agent + ingestion). Tried in order; "rules" (no model) is always the last fallback.
TRIVENI_LLM_PROVIDERS=groq,gemini,anthropic,rules
GROQ_API_KEY=
# Groq's daily token limit is per model: if one is used up, switch (openai/gpt-oss-120b is fast with tool calls)
TRIVENI_GROQ_MODEL=qwen/qwen3.8-27b
# Live requests also try these Groq models in turn (each has its own free-tier quota); override with a comma list
# TRIVENI_GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GEMINI_API_KEY=
TRIVENI_GEMINI_MODEL=gemini-3.8-flash
# Live UI requests: longest rate-limit wait (s) before falling back to the next provider. CLI/eval wait up to 30 s.
TRIVENI_UI_MAX_WAIT=0
# optional, only if you have credits
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Replay recorded tool results instead of calling the model (demo safety net)
DEMO_REPLAY=0

# Deployed UI origins (backend CORS). Exact list, and/or a regex for every Vercel URL of the project
TRIVENI_CORS_ORIGINS=http://localhost:3001
# TRIVENI_CORS_ORIGIN_REGEX=https://triveni[a-z0-9-]*\.vercel\.app
